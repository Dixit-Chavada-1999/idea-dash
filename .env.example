# Copy to .env.local. Frontend env only — never put DB or provider credentials here,
# anything VITE_-prefixed is compiled into the browser bundle.

# Where the API lives. Read at BUILD time and baked into the bundle — changing it
# on the server after `npm run build` has no effect. Leave blank only when the API
# is served from the same origin under /api (dev, via the proxy below).
# Production value lives in .env.production.
VITE_API_URL=

# Dev-only: what `npm run dev` proxies /api to
VITE_API_PROXY=http://localhost:5000
