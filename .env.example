# Copy to .env.local. Frontend env only — never put DB or provider credentials here,
# anything VITE_-prefixed is compiled into the browser bundle.

# Where the API lives in production (leave blank to use same-origin /api)
VITE_API_URL=

# Dev-only: what `npm run dev` proxies /api to
VITE_API_PROXY=http://localhost:4000
